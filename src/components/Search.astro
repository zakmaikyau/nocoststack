---
<div class="search">
  <label for="q" class="small">Search paid tools or free alternatives</label>
  <input id="q" type="search" placeholder="Try &quot;Photoshop&quot; or &quot;Notion&quot;" autocomplete="off" />
  <ul id="results" class="results" aria-live="polite"></ul>
</div>

<script>
  type Item = { title: string; url: string; text: string; sub: string };
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results') as HTMLUListElement;
  let items: Item[] | null = null;

  async function load() {
    if (items) return items;
    try {
      const res = await fetch('/search-index.json');
      items = await res.json();
    } catch {
      items = [];
    }
    return items!;
  }

  function render(matches: Item[]) {
    list.innerHTML = '';
    for (const m of matches.slice(0, 8)) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = m.url;
      a.textContent = m.title;
      const s = document.createElement('small');
      s.textContent = m.sub;
      a.appendChild(s);
      li.appendChild(a);
      list.appendChild(li);
    }
  }

  input.addEventListener('focus', load, { once: true });
  input.addEventListener('input', async () => {
    const q = input.value.trim().toLowerCase();
    if (!q) return render([]);
    const data = await load();
    render(data.filter((i) => i.text.includes(q)));
  });
</script>
